# Copy to .env and fill in EVERY value (never commit .env - it is git-ignored).
# Generate a strong value with:  openssl rand -hex 32      (PowerShell: -join ((1..32) | % { '{0:x2}' -f (Get-Random -Max 256) }))
JWT_SECRET=
JWT_EXPIRES_IN=1h

# MongoDB (authentication enabled). Use letters/digits only (hex is ideal) so the URI needs no escaping.
MONGO_USER=
MONGO_PASSWORD=

# Password given to the demo accounts by `docker compose run --rm api npm run seed`.
# Must satisfy the password policy (>= 8 chars, upper, lower, digit, symbol). If empty a random one is printed.
SEED_PASSWORD=

LOGIN_MAX_ATTEMPTS=5
LOCKOUT_MINUTES=15
# Rate limits (defaults 10 auth requests / 20 bookings). CI raises them so the
# automated Newman + Playwright runs are not throttled - keep the defaults in real use.
AUTH_RATE_LIMIT_MAX=10
BOOKING_RATE_LIMIT_MAX=20

# Grafana Cloud Loki (optional cloud logging). Leave empty to disable. See monitoring/README.md
LOKI_URL=
LOKI_USER=
LOKI_API_KEY=
LOKI_ENV=docker
