# Copy to .env and fill in. NEVER commit the real .env file.
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/hustlehub
# Generate with: openssl rand -hex 32   (>= 32 chars; enforced when NODE_ENV=production)
JWT_SECRET=6521352cdffd9537f2b706b787046672188d1a72f6e1f0f1c9985ee51347b201
JWT_EXPIRES_IN=1h
CORS_ORIGIN=http://localhost:5173
# Account lockout (security feature)
LOGIN_MAX_ATTEMPTS=5
LOCKOUT_MINUTES=15
# Cloud logging to Grafana Cloud Loki (optional - leave empty to disable)
LOKI_URL=
LOKI_USER=
LOKI_API_KEY=
LOKI_ENV=development
# Logging
LOG_DIR=./logs
